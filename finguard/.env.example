# Copy to .env.local (never commit it).
# With no key, FinGuard runs fully offline with a built-in model that follows the same goals and tools.

# Real model: set your Anthropic key; FinGuard then uses claude-haiku-4-5 by default.
# ANTHROPIC_API_KEY=

# Optional: pick any model Mozaik supports, e.g. claude-sonnet-4-6, gpt-5.4-mini (needs OPENAI_API_KEY).
# FINGUARD_MODEL=
