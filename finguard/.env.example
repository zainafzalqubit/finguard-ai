# Copy to .env.local (never commit it), then restart `pnpm dev`.
# Every provider with a key appears in the New audit dialog's Model switch. Offline is always there.
# Defaults are free models.

# Gemini (free tier, ~15 requests/min; a sample audit takes ~3.5 min). Key: https://aistudio.google.com
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter (free models allow ~50 requests/day without credits; one audit needs ~60)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free

# Paid providers, only if you add a key:
# ANTHROPIC_API_KEY=      (ANTHROPIC_MODEL, default claude-haiku-4-5)
# OPENAI_API_KEY=         (OPENAI_MODEL, default gpt-5.4-mini)

# Which provider is preselected (gemini | openrouter | anthropic | openai | offline).
# Without it: the first one with a key, in the order above.
# FINGUARD_PROVIDER=gemini
